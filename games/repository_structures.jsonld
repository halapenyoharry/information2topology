{
  "@context": {
    "schema": "https://schema.org/",
    "i2t": "https://halapenyoharry.github.io/i2t-vocab#",
    "name": "schema:name",
    "description": "schema:description",
    "codeRepository": "schema:codeRepository",
    "programmingLanguage": "schema:programmingLanguage",
    "license": "schema:license",
    "applicationCategory": "schema:applicationCategory",
    "isBasedOn": { "@id": "schema:isBasedOn", "@type": "@id" },
    "engineFramework":     { "@id": "i2t:engineFramework",     "@type": "@id" },
    "uiFramework":         { "@id": "i2t:uiFramework",         "@type": "@id" },
    "minimapMechanism":    { "@id": "i2t:minimapMechanism",    "@type": "@id" },
    "buildSystem":         { "@id": "i2t:buildSystem",         "@type": "@id" },
    "ciPlatform":          { "@id": "i2t:ciPlatform",          "@type": "@id" },
    "scriptingLanguage":   "i2t:scriptingLanguage",
    "containsFolder":      "i2t:containsFolder",
    "containsFile":        "i2t:containsFile",
    "submodule":           "i2t:submodule"
  },
  "@graph": [
    {
      "@id": "https://github.com/luanti-org/luanti",
      "@type": "schema:SoftwareSourceCode",
      "name": "Luanti",
      "description": "C++ voxel game-creation platform with Lua modding API (formerly Minetest).",
      "codeRepository": "https://github.com/luanti-org/luanti",
      "programmingLanguage": ["C++"],
      "scriptingLanguage": ["Lua"],
      "applicationCategory": "Voxel sandbox",
      "engineFramework":  { "@id": "i2t:engine/custom-voxel-luanti" },
      "uiFramework":      { "@id": "i2t:ui/luanti-hud" },
      "minimapMechanism": { "@id": "i2t:minimap/flag-driven" },
      "buildSystem":      [{ "@id": "i2t:build/cmake" }],
      "ciPlatform":       [{ "@id": "i2t:ci/gitlab" }],
      "containsFolder": [".github", ".vscode", "android", "builtin", "client", "clientmods", "cmake", "doc", "fastlane", "fonts", "games", "irr", "lib", "misc", "mods", "po", "src", "textures", "util", "worlds"],
      "containsFile":   [".clang-tidy", ".dockerignore", ".editorconfig", ".envrc", ".gitattributes", ".gitignore", ".gitlab-ci.yml", ".luacheckrc", ".mailmap", "CMakeLists.txt", "CMakePresets.json", "CNAME", "COPYING.LESSER", "Dockerfile", "LICENSE.txt", "README.md", "minetest.conf.example", "shell.nix", "vcpkg.json"]
    },
    {
      "@id": "https://github.com/MovingBlocks/Terasology",
      "@type": "schema:SoftwareSourceCode",
      "name": "Terasology",
      "description": "Modular Java voxel sandbox with gestalt module ecosystem.",
      "codeRepository": "https://github.com/MovingBlocks/Terasology",
      "programmingLanguage": ["Java"],
      "applicationCategory": "Voxel sandbox",
      "engineFramework":  { "@id": "i2t:engine/custom-voxel-tera" },
      "uiFramework":      { "@id": "i2t:ui/teranui" },
      "minimapMechanism": { "@id": "i2t:minimap/module-overlay" },
      "buildSystem":      [{ "@id": "i2t:build/gradle" }],
      "ciPlatform":       [{ "@id": "i2t:ci/jenkins" }],
      "containsFolder": [".github", ".idea", "build-logic", "config", "docs", "docs-pre-merge", "engine", "engine-tests", "facades", "fileTemplates", "gradle", "libs", "metas", "modules", "openvr_natives", "subsystems", "templates"],
      "containsFile":   [".gitattributes", ".gitignore", ".gitpod.yml", "Jenkinsfile", "LICENSE", "LICENSE_ARTWORK", "NOTICE", "README.md", "build.gradle.kts", "gitpod.dockerfile", "gradlew", "gradlew.bat", "groovyw", "groovyw.bat", "settings.gradle.kts"]
    },
    {
      "@id": "https://github.com/OpenMW/openmw",
      "@type": "schema:SoftwareSourceCode",
      "name": "OpenMW",
      "description": "C++ reimplementation of the Morrowind engine.",
      "codeRepository": "https://github.com/OpenMW/openmw",
      "programmingLanguage": ["C++"],
      "scriptingLanguage": ["Lua"],
      "applicationCategory": "RPG engine reimplementation",
      "engineFramework":  { "@id": "i2t:engine/osg-mygui" },
      "uiFramework":      { "@id": "i2t:ui/mygui" },
      "minimapMechanism": { "@id": "i2t:minimap/cell-rendering" },
      "buildSystem":      [{ "@id": "i2t:build/cmake" }],
      "ciPlatform":       [{ "@id": "i2t:ci/gitlab" }, { "@id": "i2t:ci/gh-actions" }],
      "containsFolder": [".github", ".gitlab", "CI", "apps", "cmake", "components", "docker", "docs", "extern", "files", "manual", "scripts"],
      "containsFile":   [".clang-format", ".clang-tidy", ".editorconfig", ".git-blame-ignore-revs", ".gitignore", ".gitlab-ci.yml", ".readthedocs.yaml", ".resubmitted_merge_requests.txt", "AUTHORS.md", "CHANGELOG.md", "CMakeLists.txt", "CONTRIBUTING.md", "LICENSE", "README.md"]
    },
    {
      "@id": "https://github.com/Unvanquished/Unvanquished",
      "@type": "schema:SoftwareSourceCode",
      "name": "Unvanquished",
      "description": "FPS/RTS hybrid powered by the Dæmon engine.",
      "codeRepository": "https://github.com/Unvanquished/Unvanquished",
      "programmingLanguage": ["C++"],
      "applicationCategory": "FPS/RTS hybrid",
      "engineFramework":  { "@id": "i2t:engine/daemon" },
      "uiFramework":      { "@id": "i2t:ui/rmlui" },
      "minimapMechanism": { "@id": "i2t:minimap/bsp-orthographic" },
      "buildSystem":      [{ "@id": "i2t:build/cmake" }, { "@id": "i2t:build/urcheon" }],
      "ciPlatform":       [{ "@id": "i2t:ci/gh-actions" }],
      "containsFolder": [".github", ".urcheon", "debian", "dist", "libs", "macosx", "pkg", "src", "tools"],
      "containsFile":   [".appveyor.yml", ".git-blame-ignore-revs", ".gitattributes", ".gitignore", ".gitmodules", "CMakeLists.txt", "COPYING.txt", "GPL.txt", "README.md", "azure-pipelines.yml", "daemon", "download-paks", "lua.cmake", "rmlui.cmake", "src.cmake", "update-version-number.py"],
      "submodule": ["daemon"]
    },

    { "@id": "i2t:engine/custom-voxel-luanti", "@type": "i2t:EngineFramework", "name": "Luanti custom voxel engine" },
    { "@id": "i2t:engine/custom-voxel-tera",   "@type": "i2t:EngineFramework", "name": "Terasology custom voxel engine" },
    { "@id": "i2t:engine/osg-mygui",           "@type": "i2t:EngineFramework", "name": "OpenSceneGraph + MyGUI" },
    { "@id": "i2t:engine/daemon",              "@type": "i2t:EngineFramework", "name": "Dæmon engine (ioq3 + XreaL)" },

    { "@id": "i2t:ui/teranui",    "@type": "i2t:UIFramework", "name": "TeraNUI" },
    { "@id": "i2t:ui/rmlui",      "@type": "i2t:UIFramework", "name": "RmlUi" },
    { "@id": "i2t:ui/mygui",      "@type": "i2t:UIFramework", "name": "MyGUI" },
    { "@id": "i2t:ui/luanti-hud", "@type": "i2t:UIFramework", "name": "Luanti native HUD" },

    { "@id": "i2t:minimap/flag-driven",       "@type": "i2t:MinimapMechanism", "name": "Configurable HUD flags / engine-to-HUD mapping" },
    { "@id": "i2t:minimap/module-overlay",    "@type": "i2t:MinimapMechanism", "name": "Independent module overlay" },
    { "@id": "i2t:minimap/cell-rendering",    "@type": "i2t:MinimapMechanism", "name": "Internal UI mapping / cell rendering" },
    { "@id": "i2t:minimap/bsp-orthographic",  "@type": "i2t:MinimapMechanism", "name": "Orthogonal projection of BSP map" },

    { "@id": "i2t:build/cmake",   "@type": "i2t:BuildSystem", "name": "CMake" },
    { "@id": "i2t:build/gradle",  "@type": "i2t:BuildSystem", "name": "Gradle (Kotlin DSL)" },
    { "@id": "i2t:build/urcheon", "@type": "i2t:BuildSystem", "name": "Urcheon" },

    { "@id": "i2t:ci/gitlab",     "@type": "i2t:CIPlatform", "name": "GitLab CI" },
    { "@id": "i2t:ci/jenkins",    "@type": "i2t:CIPlatform", "name": "Jenkins" },
    { "@id": "i2t:ci/gh-actions", "@type": "i2t:CIPlatform", "name": "GitHub Actions" }
  ]
}
