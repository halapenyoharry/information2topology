  "style": [
    {
      "selector": "node",
      "style": {
        "label": "data(label)",
        "text-valign": "center",
        "text-halign": "center",
        "font-size": "11px",
        "text-wrap": "wrap",
        "text-max-width": "80px",
        "width": "40px",
        "height": "40px",
        "border-width": 1,
        "border-color": "#555"
      }
    },

    {
      "selector": "node.character",
      "style": {
        "background-color": "#F8C8DC",
        "shape": "ellipse"
      }
    },
    {
      "selector": "node.protagonist",
      "style": {
        "background-color": "#E8607A",
        "width": "55px",
        "height": "55px",
        "font-weight": "bold",
        "font-size": "13px"
      }
    },
    {
      "selector": "node.antagonist",
      "style": {
        "background-color": "#D44D4D",
        "shape": "diamond"
      }
    },
    {
      "selector": "node.witch",
      "style": {
        "shape": "star",
        "border-color": "#7B3F9E"
      }
    },
    {
      "selector": "node.animated",
      "style": {
        "background-color": "#F8D8C8",
        "shape": "round-rectangle"
      }
    },
    {
      "selector": "node.place",
      "style": {
        "background-color": "#C8E0F8",
        "shape": "round-rectangle"
      }
    },
    {
      "selector": "node.container",
      "style": {
        "background-color": "#E8F0FF",
        "background-opacity": 0.3,
        "border-width": 2,
        "border-style": "dashed",
        "border-color": "#6B9BD2",
        "text-valign": "top",
        "text-halign": "center",
        "font-size": "14px",
        "font-weight": "bold",
        "padding": "30px"
      }
    },
    {
      "selector": "node.item",
      "style": {
        "background-color": "#E8DCC0",
        "shape": "hexagon",
        "width": "30px",
        "height": "30px"
      }
    },
    {
      "selector": "node.magical",
      "style": {
        "border-width": 2,
        "border-color": "#DAA520",
        "border-style": "double"
      }
    },
    {
      "selector": "node.theme",
      "style": {
        "background-color": "#F8F0C8",
        "shape": "round-tag",
        "width": "35px",
        "height": "35px",
        "font-style": "italic",
        "background-opacity": 0.6
      }
    },

    {
      "selector": "edge",
      "style": {
        "label": "data(label)",
        "font-size": "9px",
        "text-rotation": "autorotate",
        "text-margin-y": -8,
        "curve-style": "bezier",
        "opacity": 0.7
      }
    },

    {
      "selector": "edge.state_change",
      "style": {
        "line-color": "#E87D3E",
        "target-arrow-color": "#E87D3E",
        "target-arrow-shape": "triangle",
        "width": "mapData(weight, 0, 1, 1, 6)",
        "line-style": "solid",
        "opacity": 0.9
      }
    },
    {
      "selector": "edge.spine",
      "style": {
        "line-color": "#D95B1A",
        "target-arrow-color": "#D95B1A",
        "width": "mapData(weight, 0, 1, 2, 8)",
        "z-index": 10,
        "opacity": 1.0
      }
    },
    {
      "selector": "edge.interactivity",
      "style": {
        "line-color": "#9B59B6",
        "target-arrow-shape": "none",
        "width": "mapData(weight, 0, 1, 1, 4)",
        "line-style": "solid",
        "opacity": 0.6,
        "curve-style": "unbundled-bezier"
      }
    },
    {
      "selector": "edge.reference",
      "style": {
        "line-color": "#95A5A6",
        "target-arrow-shape": "none",
        "width": 1,
        "line-style": "dotted",
        "opacity": 0.35
      }
    },
    {
      "selector": "edge.containment",
      "style": {
        "line-color": "#3498DB",
        "width": 2,
        "line-style": "dashed",
        "opacity": 0.4
      }
    },

    {
      "selector": ":selected",
      "style": {
        "background-color": "#FFD700",
        "border-width": 3,
        "border-color": "#333"
      }
    }
  ],

  "layout": {
    "name": "cose",
    "idealEdgeLength": 120,
    "nodeOverlap": 20,
    "padding": 40,
    "animate": true,
    "animationDuration": 500,
    "nestingFactor": 0.5
  }
}
