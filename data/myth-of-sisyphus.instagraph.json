  "nodes": [
    {"id": "camus", "label": "Albert Camus", "type": "Philosopher", "color": "#F8C8DC", "properties": {"lifespan": "1913-1960", "role": "author of the essay; the philosophical voice"}},
    {"id": "sartre", "label": "Jean-Paul Sartre", "type": "Philosopher", "color": "#F8C8DC", "properties": {"role": "contrasted with Camus; for Sartre absurdity precedes consciousness"}},
    {"id": "kierkegaard", "label": "Søren Kierkegaard", "type": "Philosopher", "color": "#F8C8DC", "properties": {"role": "discovers and lives the absurd, but performs the leap to faith"}},
    {"id": "nietzsche", "label": "Friedrich Nietzsche", "type": "Philosopher", "color": "#F8C8DC", "properties": {"role": "post-God absurdist forerunner; influences Camus's notion of the absurd"}},
    {"id": "heidegger", "label": "Martin Heidegger", "type": "Philosopher", "color": "#F8C8DC", "properties": {"role": "centers existence on anguish; consciousness of death"}},
    {"id": "jaspers", "label": "Karl Jaspers", "type": "Philosopher", "color": "#F8C8DC", "properties": {"role": "starts from failure of knowledge, leaps to transcendence"}},
    {"id": "shestov", "label": "Lev Shestov", "type": "Philosopher", "color": "#F8C8DC", "properties": {"role": "irrationalist; demonstrates rationalism stumbles on the irrational; leaps to God"}},
    {"id": "husserl", "label": "Edmund Husserl", "type": "Philosopher", "color": "#F8C8DC", "properties": {"role": "founder of phenomenology; reinstates world's diversity, denies transcendent reason"}},
    {"id": "aristotle", "label": "Aristotle", "type": "Philosopher", "color": "#F8C8DC", "properties": {"role": "cited for the contradiction at the root of self-reflective thought"}},
    {"id": "pascal", "label": "Blaise Pascal", "type": "Philosopher", "color": "#F8C8DC", "properties": {"role": "named diversion (eluding) as a structure of human evasion"}},
    {"id": "schopenhauer", "label": "Arthur Schopenhauer", "type": "Philosopher", "color": "#F8C8DC", "properties": {"role": "praised suicide while seated at a well-set table — Camus's example of un-lived philosophy"}},
    {"id": "dostoevsky", "label": "Fyodor Dostoevsky", "type": "Writer", "color": "#F8D8C8", "properties": {"role": "creator of Kirilov, who carries suicide-as-logical-conclusion"}},
    {"id": "sophocles", "label": "Sophocles", "type": "Writer", "color": "#F8D8C8", "properties": {"role": "Œdipus is a model for the absurd victory through consciousness"}},
    {"id": "homer", "label": "Homer", "type": "Writer", "color": "#F8D8C8", "properties": {"role": "preserves the Sisyphus myth; Sisyphus 'wisest of mortals'"}},
    {"id": "myth_of_sisyphus", "label": "The Myth of Sisyphus", "type": "Work", "color": "#C8E0F8", "properties": {"year": 1942, "role": "the essay; elucidates the absurd and refuses suicide"}},
    {"id": "the_plague", "label": "The Plague", "type": "Work", "color": "#C8E0F8", "properties": {"year": 1947, "role": "novel; the painful death of a child epitomizes the absurd"}},
    {"id": "the_rebel", "label": "The Rebel", "type": "Work", "color": "#C8E0F8", "properties": {"year": 1951, "role": "extends revolt into political ethic; opposes totalitarianism"}},
    {"id": "absurd", "label": "the Absurd", "type": "Concept", "color": "#F8F0C8", "properties": {"definition": "born of the confrontation between human longing for meaning and the silent, irrational world", "centrality": "the central object of the essay"}},
    {"id": "suicide", "label": "Suicide", "type": "Concept", "color": "#F8F0C8", "properties": {"role": "Camus calls it 'the only truly serious philosophical problem'; ultimately rejected as a response to the absurd"}},
    {"id": "lucidity", "label": "Lucidity", "type": "Concept", "color": "#F8F0C8", "properties": {"definition": "clarity of mind that refuses comforting illusions and self-deception; Camus's analogue to anguish"}},
    {"id": "revolt", "label": "Revolt", "type": "Concept", "color": "#F8F0C8", "properties": {"role": "first consequence of the absurd: the conscious refusal to consent to it"}},
    {"id": "absurd_freedom", "label": "Absurd Freedom", "type": "Concept", "color": "#F8F0C8", "properties": {"role": "second consequence: freedom from the illusion of metaphysical liberty; freedom of action without future"}},
    {"id": "passion", "label": "Passion", "type": "Concept", "color": "#F8F0C8", "properties": {"role": "third consequence: maximizing quantity and intensity of conscious experience"}},
    {"id": "hope", "label": "Hope", "type": "Concept", "color": "#F8F0C8", "properties": {"role": "the chief form of eluding; named as the third theme of the essay; rejected by absurd reasoning"}},
    {"id": "death", "label": "Death", "type": "Concept", "color": "#F8F0C8", "properties": {"role": "the irreparable; the cruel mathematics that crowns the absurd"}},
    {"id": "consciousness", "label": "Consciousness", "type": "Concept", "color": "#F8F0C8", "properties": {"role": "everything begins with consciousness; awakening from mechanical life inaugurates the absurd"}},
    {"id": "reason", "label": "Reason", "type": "Concept", "color": "#F8F0C8", "properties": {"role": "the rationalist project; not negated absolutely, but shown to founder on the irrational"}},
    {"id": "irrational", "label": "the Irrational", "type": "Concept", "color": "#F8F0C8", "properties": {"role": "the unreasonable silence of the world; one of the two terms of the absurd"}},
    {"id": "nostalgia_for_unity", "label": "Nostalgia for Unity", "type": "Concept", "color": "#F8F0C8", "properties": {"role": "the human appetite for the absolute and for clarity; the other term of the absurd"}},
    {"id": "anguish", "label": "Anguish (Anxiety)", "type": "Concept", "color": "#F8F0C8", "properties": {"role": "Heidegger's perpetual climate of the lucid mind; sibling concept to Camus's lucidity"}},
    {"id": "leap", "label": "the Leap", "type": "Concept", "color": "#F8F0C8", "properties": {"role": "the existential move from absurd to faith / God / transcendence; Camus's name for the betrayal of the absurd"}},
    {"id": "philosophical_suicide", "label": "Philosophical Suicide", "type": "Concept", "color": "#F8F0C8", "properties": {"role": "Camus's term for the leap: existential thought presupposes the absurd only to dispel it"}},
    {"id": "eluding", "label": "Eluding (Diversion)", "type": "Concept", "color": "#F8F0C8", "properties": {"role": "Pascalian; the pretense of a future, a meaning, or an other-life that masks the present condition"}},
    {"id": "quantity_over_quality", "label": "Quantity over Quality", "type": "Concept", "color": "#F8F0C8", "properties": {"role": "Don Juan's ethic; substitute the most living for the best living"}},
    {"id": "transcendence", "label": "Transcendence", "type": "Concept", "color": "#F8F0C8", "properties": {"role": "Jaspers's leap-target; what failure paradoxically reveals"}},
    {"id": "god", "label": "God (the Absurd's terminus)", "type": "Concept", "color": "#F8F0C8", "properties": {"role": "Shestov's leap-target; identified with the absurd itself in mystical readings; Camus's contested object"}},
    {"id": "the_confrontation", "label": "the Confrontation", "type": "Concept", "color": "#F8F0C8", "properties": {"role": "the unceasing struggle between human nostalgia and the silent world; the absurd is born of it, not in either term"}},
    {"id": "absurd_man", "label": "the Absurd Man", "type": "Archetype", "color": "#DCC8F8", "properties": {"role": "the figure who lives the absurd without the leap: lucid, revolting, free, passionate"}},
    {"id": "absurd_hero", "label": "the Absurd Hero", "type": "Archetype", "color": "#DCC8F8", "properties": {"role": "the form taken by Sisyphus, Œdipus, Don Juan: superior to fate through consciousness"}},
    {"id": "don_juan", "label": "Don Juan", "type": "Archetype", "color": "#DCC8F8", "properties": {"role": "Kierkegaard's 'Don Juan of the understanding' figure; archetype of quantity-over-quality"}},
    {"id": "oedipus", "label": "Œdipus", "type": "LiteraryFigure", "color": "#C8F8DC", "properties": {"source": "Sophocles", "role": "concludes 'all is well'; ancient counterpart of the absurd victory"}},
    {"id": "hamlet", "label": "Hamlet", "type": "LiteraryFigure", "color": "#C8F8DC", "properties": {"source": "Shakespeare", "role": "'the time is out of joint' — quoted by Shestov as scaffold for hope, by Camus as evidence of the absurd"}},
    {"id": "kirilov", "label": "Kirilov", "type": "LiteraryFigure", "color": "#C8F8DC", "properties": {"source": "Dostoevsky, Demons", "role": "carried suicide as logical conclusion of refusing meaning to life"}},
    {"id": "sisyphus", "label": "Sisyphus", "type": "MythologicalFigure", "color": "#F8C8B8", "properties": {"source": "Greek myth; Homer", "role": "wisest of mortals; chained Death; defied the gods; condemned to roll the rock; the absurd hero"}},
    {"id": "pluto", "label": "Pluto", "type": "MythologicalFigure", "color": "#F8C8B8", "properties": {"role": "ruler of the underworld; condemned Sisyphus"}},
    {"id": "mercury", "label": "Mercury", "type": "MythologicalFigure", "color": "#F8C8B8", "properties": {"role": "seized Sisyphus and returned him to the underworld"}},
    {"id": "the_rock", "label": "the Rock", "type": "Object", "color": "#E8DCC0", "properties": {"role": "Sisyphus's burden; symbol of futile and hopeless labor; what the conscious hero is stronger than"}},
    {"id": "existentialism", "label": "Existentialism", "type": "Movement", "color": "#E0E0E0", "properties": {"role": "the philosophical movement Camus is in dialogue with — and accuses of philosophical suicide"}},
    {"id": "phenomenology", "label": "Phenomenology", "type": "Movement", "color": "#E0E0E0", "properties": {"role": "Husserl's method; reinstates world's diversity; denies transcendent reason"}},
    {"id": "christianity", "label": "Christianity", "type": "Movement", "color": "#E0E0E0", "properties": {"role": "the religious tradition Kierkegaard leaps into; one of the leap's named destinations"}},
    {"id": "totalitarianism", "label": "Totalitarianism", "type": "Movement", "color": "#E0E0E0", "properties": {"role": "fascist or communist; named in The Rebel as the most horrifying enemy of revolt"}},
    {"id": "bourgeois_morality", "label": "Bourgeois Morality", "type": "Movement", "color": "#E0E0E0", "properties": {"role": "named in The Rebel as the more obvious enemy of lucid revolt"}}
  ],
